        "response": "Your response to user",
        "current_agent": "your_agent_name"
    }


def submit_your_request(state: AgentState) -> dict:
    """
    Final submission node.
    Marks the agent workflow as complete.
    """
    # Your submission logic here
    # ...

    return {
        "agent_completed": True,
        "current_agent": None,
        "response": "Submission successful message"
    }


def route_your_decision(state: AgentState) -> Literal["process", "submit", "unclear"]:
    """
    Conditional edge function to route based on user's response.
    """
    messages = state.get("messages", [])
    if not messages:
        return "unclear"

    last_message = messages[-1]
    user_message = last_message.content.lower() if hasattr(last_message, 'content') else ""

    # Your routing logic
    if "submit" in user_message or "confirm" in user_message:
        return "submit"
    else:
        return "process"
